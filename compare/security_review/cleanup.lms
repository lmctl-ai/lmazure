# AzureRM equivalent plus an explicit builtin-provider offline fixture; never authenticates by default.
mkdir("build"); mkdir("build/lmcloud_security_review"); mkdir("build/lmcloud_security_review/azure"); mkdir("build/lmcloud_security_review/offline");
let mode = getenv("LMAZURE_COMPARE_MODE", "offline");
assert(mode == "offline" || mode == "live");
let run_id = getenv("LMAZURE_COMPARE_RUN_ID", "0123456789ab");
let dir = "build/lmcloud_security_review/offline";
let cap = 0.05;
let admitted = true;
if (mode == "live") {
  assert(getenv("CI", "") != "true", "live comparison is forbidden in CI");
  assert(getenv("LMAZURE_COMPARE_LIVE_APPROVED", "") == "1" && getenv("LMAZURE_LIVE", "") == "1", "user-approved local live testing is required");
  let auth = json_parse(read_file(getenv("LMAZURE_COMPARE_AUTH_FILE", "missing-authorization.json")));
  assert(getstr(auth,"example") == "security_review" && getstr(auth,"run_id") == run_id && getbool(auth,"preflight_complete"), "use compare/run.sh for ownership preflight");

  dir = "build/lmcloud_security_review/azure";
}
dir = mode == "live" ? "build/lmcloud_security_review/azure" : "build/lmcloud_security_review/offline";
c = _lmcode_ cli="lmcloud" install="github:lmctl-ai/lmcloud@v0.1.9";
let dir = ${dir};
let destroyed = tofu.destroy(dir);
file_write("build/lmcloud_security_review/destroy.ok",str(destroyed));
file_write("build/lmcloud_security_review/after-destroy.txt",tofu.state_list(dir));
end _lmcode_

r = run_lmcode(c);
assert(r.ok, "lmcode host failed");
