# AzureRM equivalent plus an explicit builtin-provider offline fixture; never authenticates by default.
mkdir("build"); mkdir("build/lmcloud_owned_budget_admission"); mkdir("build/lmcloud_owned_budget_admission/azure"); mkdir("build/lmcloud_owned_budget_admission/offline");
let mode = getenv("LMAZURE_COMPARE_MODE", "offline");
assert(mode == "offline" || mode == "live");
let run_id = getenv("LMAZURE_COMPARE_RUN_ID", "0123456789ab");
let dir = "build/lmcloud_owned_budget_admission/offline";
let cap = 0.0002;
let admitted = false;
if (mode == "live") {
  assert(getenv("CI", "") != "true", "live comparison is forbidden in CI");
  assert(getenv("LMAZURE_COMPARE_LIVE_APPROVED", "") == "1" && getenv("LMAZURE_LIVE", "") == "1", "user-approved local live testing is required");
  let auth = json_parse(read_file(getenv("LMAZURE_COMPARE_AUTH_FILE", "missing-authorization.json")));
  assert(getstr(auth,"example") == "owned_budget_admission" && getstr(auth,"run_id") == run_id && getbool(auth,"preflight_complete"), "use compare/run.sh for ownership preflight");
  assert(getenv("LMAZURE_ALLOW_WRITES","")=="1");
  dir = "build/lmcloud_owned_budget_admission/azure";
}
dir = mode == "live" ? "build/lmcloud_owned_budget_admission/azure" : "build/lmcloud_owned_budget_admission/offline";
c = _lmcode_ cli="lmcloud" install="github:lmctl-ai/lmcloud@v0.1.9";
let dir = ${dir};
let destroyed = tofu.destroy(dir);
file_write("build/lmcloud_owned_budget_admission/destroy.ok",str(destroyed));
file_write("build/lmcloud_owned_budget_admission/after-destroy.txt",tofu.state_list(dir));
end _lmcode_
savedsl(c,"build/lmcloud_owned_budget_admission/recovery.dslb");
r = system(concat(dsl_cli(c),["--lmcode","build/lmcloud_owned_budget_admission/recovery.dslb"]),180000);
assert(r.code==0);
