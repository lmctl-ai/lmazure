# Mock-only Azure resource inventory by item count.
mkdir("images"); mkdir("data"); mkdir("build");
azure = _dsl_ cli="lmazure" install="github:lmctl-ai/lmazure@latest";
let s = mock();
let t = s.inventory("resources");
t.csv("data/resource_inventory.csv");
s.readonly_cost_report("data/resource_inventory_cost_evidence.json");
end _dsl_
savedsl(azure, "build/resource_inventory.dslb");
r = system ${dsl_cli(azure)} --lmcode build/resource_inventory.dslb;
assert(r.code == 0);
let rows = csv_parse(read_file("data/resource_inventory.csv"), false);
assert(rows[0].len() == 10);
let cost_report = json_parse(read_file("data/resource_inventory_cost_evidence.json"));
assert(getstr(cost_report, "mode") == "fake");
assert(getnum(cost_report, "estimated_cost_usd") == 0.0);
assert(getlist(cost_report, "resources").len() == 0);
let metadata = get(cost_report, "metadata_inventory");
assert(getnum(metadata, "arm_requests") == 1);
assert(rows.len() == 25);
p = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/resource_inventory.png", 900, 560);
plot.cmd("set title 'MOCK resource age inventory'; set xlabel 'Age hours'; set ylabel ''; set key off; set datafile separator ','; set style fill solid 0.85; set xrange [0:1050]; set yrange [23.5:-0.5]; set lmargin 14; set ytics font ',9'; plot 'data/resource_inventory.csv' every ::1 using ($6/2):0:($6/2):(0.35):ytic(1) with boxxyerrorbars lc rgb '#0ea5e9'");
plot.close();
end _dsl_
savedsl(p, "build/resource_inventory_plot.dslb");
r = system ${dsl_cli(p)} --lmcode build/resource_inventory_plot.dslb;
assert(r.code == 0);
println("wrote images/resource_inventory.png");
println("estimated cost: $0.00");
