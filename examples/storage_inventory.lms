# Mock-only Azure storage inventory by item count.
mkdir("images"); mkdir("data"); mkdir("build");
azure = _dsl_ cli="lmazure" install="github:lmctl-ai/lmazure@latest";
let s = mock();
let t = s.inventory("storage");
t.csv("data/storage_inventory.csv");
end _dsl_
savedsl(azure, "build/storage_inventory.dslb");
r = system ${dsl_cli(azure)} --dsl build/storage_inventory.dslb;
assert(r.code == 0);
let rows = csv_parse(read_file("data/storage_inventory.csv"), false);
assert(rows[0].len() == 10);
assert(rows.len() == 4);
p = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/storage_inventory.png", 900, 560);
plot.cmd("set title 'MOCK Storage age horizon'; set xlabel 'Resource'; set ylabel 'Age hours'; set xtics rotate by -90 right font ',8'; set key outside top center horizontal; set yrange [0:*]; set style data histograms; set style fill solid 0.8; set datafile separator ','; plot 'data/storage_inventory.csv' every ::1 using 6:xtic(1) title 'mock age horizon'");
plot.close();
end _dsl_
savedsl(p, "build/storage_inventory_plot.dslb");
r = system ${dsl_cli(p)} --dsl build/storage_inventory_plot.dslb;
assert(r.code == 0);
println("wrote images/storage_inventory.png");
