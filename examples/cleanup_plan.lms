# Mock-only Azure safe cleanup plan.
mkdir("images"); mkdir("data"); mkdir("build");
azure = _dsl_ cli="lmazure" install="github:lmctl-ai/lmazure@latest";
let s = mock();
let t = s.inventory("resources");
t.csv("data/cleanup_plan.csv");
s.readonly_cost_report("data/cleanup_plan_cost_evidence.json");
end _dsl_
savedsl(azure, "build/cleanup_plan.dslb");
r = system ${dsl_cli(azure)} --lmcode build/cleanup_plan.dslb;
assert(r.code == 0);
let rows = csv_parse(read_file("data/cleanup_plan.csv"), false);
assert(rows[0].len() == 10);
let cost_report = json_parse(read_file("data/cleanup_plan_cost_evidence.json"));
assert(getstr(cost_report, "mode") == "fake");
assert(getnum(cost_report, "estimated_cost_usd") == 0.0);
assert(getlist(cost_report, "resources").len() == 0);
let metadata = get(cost_report, "metadata_inventory");
assert(getnum(metadata, "arm_requests") == 1);
assert(rows.len() == 25);
let resource_count = rows.len() - 1;
p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(900, 560, "#0f1720");
scene.text(36.0, 48.0, 28.0, "Safe cleanup plan", "#f4f7fb");
scene.text(36.0, 78.0, 15.0, "Generated from a redacted mock inventory; no Azure call", "#9fb3c8");
scene.rect(70.0, 160.0, 220.0, 120.0, "#17324d");
scene.text(95.0, 215.0, 20.0, "candidates", "#f4f7fb");
scene.text(95.0, 248.0, 15.0, "rows: ${resource_count}", "#d9e2ec");
scene.rect(340.0, 160.0, 220.0, 120.0, "#17324d");
scene.text(365.0, 215.0, 20.0, "age + prefix", "#f4f7fb");
scene.text(365.0, 248.0, 15.0, "ledger check", "#d9e2ec");
scene.rect(610.0, 160.0, 220.0, 120.0, "#17324d");
scene.text(635.0, 215.0, 20.0, "cleanup", "#f4f7fb");
scene.text(635.0, 248.0, 15.0, "dry-run only", "#d9e2ec");
scene.arrow(290.0, 220.0, 340.0, 220.0, "#f2c94c", 3.0);
scene.arrow(560.0, 220.0, 610.0, 220.0, "#f2c94c", 3.0);
scene.text(70.0, 420.0, 16.0, "Only prefix-owned, ledger-owned stale rows may be swept.", "#9fb3c8");
scene.render_png("images/cleanup_plan.png", 900, 560, 1);
end _dsl_
savedsl(p, "build/cleanup_plan_draw.dslb");
r = system ${dsl_cli(p)} --lmcode build/cleanup_plan_draw.dslb;
assert(r.code == 0);
println("wrote images/cleanup_plan.png");
println("estimated cost: $0.00");
