# Mock-only owned lifecycle: Request breakdown; no Azure calls.
mkdir("images"); mkdir("data"); mkdir("build");
let azure = _dsl_ cli="lmazure" install="github:lmctl-ai/lmazure@latest";
let s = mock();
let run = s.begin_run("build/cost_request_breakdown.ledger.json");
run.cost_cap(0.05);
let created = run.queue("request-breakdown");
let resource_name = created.text(0, 0);
run.tag(resource_name, "gallery", "request-breakdown");
created.csv("data/cost_request_breakdown_created.csv");

run.cleanup();
run.cost_report("data/cost_request_breakdown_cost_evidence.json");
end _dsl_
savedsl(azure, "build/cost_request_breakdown.dslb");
r0 = system ${dsl_cli(azure)} --lmcode build/cost_request_breakdown.dslb;
assert(r0.code == 0);
let cost_report = json_parse(read_file("data/cost_request_breakdown_cost_evidence.json"));
assert(getstr(cost_report, "mode") == "fake");
let cost_text = getstr(cost_report, "estimated_cost_text");
assert(getnum(cost_report, "estimated_cost_usd") == 0.0005);
assert(getnum(cost_report, "reserved_cost_usd") == 0.0);
assert(getlist(cost_report, "requests").len() == 5);
let requests = getlist(cost_report, "requests");
assert(getstr(requests.get(0, cost_report), "method") == "PUT");
assert(getstr(requests.get(1, cost_report), "method") == "GET");
assert(getstr(requests.get(2, cost_report), "method") == "PUT");
assert(getstr(requests.get(3, cost_report), "method") == "GET");
assert(getstr(requests.get(4, cost_report), "method") == "DELETE");
let resources = getlist(cost_report, "resources");
let remaining = 0;
for (i in range(0,resources.len())) { if(getbool(resources[i],"owned")) { remaining=remaining+1; } }
assert(remaining==0);
let request_count = requests.len();
let puts=0; let gets=0; let deletes=0;
for(i in range(0,requests.len())) { let method=getstr(requests[i],"method"); if(method=="PUT") {puts=puts+1;} else if(method=="GET" || method=="HEAD") {gets=gets+1;} else if(method=="DELETE") {deletes=deletes+1;} }
assert(puts+gets+deletes==request_count);
let money = split(cost_text,"$")[1];
let reserve = getnum(cost_report,"reserved_cost_usd");
let outcome = "Cleanup complete";
if(r0.code==3) { outcome="Create rejected before HTTP"; }
let outcome_text = outcome + "; values are read from this run ledger";
write_file("data/cost_request_breakdown_derived.csv","method,requests\nPUT,"+str(puts)+"\nGET,"+str(gets)+"\nDELETE,"+str(deletes)+"\n");
assert(puts==2 && gets==2 && deletes==1);
p = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/cost_request_breakdown.png",900,560);
plot.cmd("set title 'MOCK actual storage request attempts'; set ylabel 'Request attempts'; set key off; set yrange [0:2.7]; set datafile separator ','; set style data histograms; set style fill solid 0.85; set boxwidth 0.65; set xtics norotate; set label 'Five lifecycle requests; the transport counts every attempt.' at graph 0.03,0.93 font ',11'; plot 'data/cost_request_breakdown_derived.csv' every ::1 using 2:xtic(1) lc rgb '#0ea5e9'");
plot.close();
end _dsl_
savedsl(p,"build/cost_request_breakdown_visual.dslb");
r = system ${dsl_cli(p)} --lmcode build/cost_request_breakdown_visual.dslb;
assert(r.code==0);
println("wrote images/cost_request_breakdown.png");
println(getstr(cost_report, "estimated_cost_text"));
