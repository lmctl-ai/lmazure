# Mock-only Azure dns inventory by item count.
mkdir("images"); mkdir("data"); mkdir("build");
azure = _dsl_ cli="lmazure" install="github:lmctl-ai/lmazure@latest";
let s = mock();
let t = s.inventory("dns");
t.csv("data/dns_inventory.csv");
s.readonly_cost_report("data/dns_inventory_cost_evidence.json");
end _dsl_
savedsl(azure, "build/dns_inventory.dslb");
r = system ${dsl_cli(azure)} --lmcode build/dns_inventory.dslb;
assert(r.code == 0);
let rows = csv_parse(read_file("data/dns_inventory.csv"), false);
assert(rows[0].len() == 10);
let cost_report = json_parse(read_file("data/dns_inventory_cost_evidence.json"));
assert(getstr(cost_report, "mode") == "fake");
assert(getnum(cost_report, "estimated_cost_usd") == 0.0);
assert(getlist(cost_report, "resources").len() == 0);
let metadata = get(cost_report, "metadata_inventory");
assert(getnum(metadata, "arm_requests") == 1);
assert(rows.len() == 2);
p = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/dns_inventory.png", 900, 560);
plot.cmd("set title 'MOCK DNS age horizon'; set xlabel 'Resource'; set ylabel 'Age hours'; set xtics norotate font ',11'; set key outside top center horizontal; set yrange [0:*]; set style data histograms; set style fill solid 0.8; set datafile separator ','; plot 'data/dns_inventory.csv' every ::1 using 6:xtic(1) title 'mock age horizon'");
plot.close();
end _dsl_
savedsl(p, "build/dns_inventory_plot.dslb");
r = system ${dsl_cli(p)} --lmcode build/dns_inventory_plot.dslb;
assert(r.code == 0);
println("wrote images/dns_inventory.png");
println("estimated cost: $0.00");
