# Mock-only Azure metadata analysis; no cloud writes or credentials.
mkdir("images"); mkdir("data"); mkdir("build");
azure = _dsl_ cli="lmazure" install="github:lmctl-ai/lmazure@latest";
let s = mock();
let t = s.inventory("resources");
t.csv("data/provider_resource_graph_inventory.csv");
s.readonly_cost_report("data/provider_resource_graph_cost_evidence.json");
end _dsl_
savedsl(azure, "build/provider_resource_graph.dslb");
r = system ${dsl_cli(azure)} --lmcode build/provider_resource_graph.dslb;
assert(r.code == 0);
let rows = csv_parse(read_file("data/provider_resource_graph_inventory.csv"), false);
assert(rows.len() == 25);
let ledger = json_parse(read_file("data/provider_resource_graph_cost_evidence.json"));
assert(getstr(ledger, "mode") == "fake");
assert(getnum(ledger, "estimated_cost_usd") == 0);
assert(getnum(ledger, "metadata_inventory.list_requests") == 1);
assert(getlist(ledger, "owned").len() == 0);
let network = 0; let storage = 0; let identity = 0; let other = 0;
for (i in range(1,rows.len())) {
 if (starts_with(rows[i][1],"Microsoft.Network/")) { network = network + 1; }
 else if (starts_with(rows[i][1],"Microsoft.Storage/")) { storage = storage + 1; }
 else if (starts_with(rows[i][1],"Microsoft.ManagedIdentity/")) { identity = identity + 1; }
 else { other = other + 1; }
}
assert(network == 5 && storage == 3 && identity == 2 && other == 14);
write_file("data/provider_resource_graph_derived.csv","provider,count\nnetwork,"+str(network)+"\nstorage,"+str(storage)+"\nidentity,"+str(identity)+"\nother,"+str(other)+"\n");
p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(900,560,"#0f1720");
scene.text(30.0,45.0,27.0,"Provider containment graph","#f4f7fb");
scene.text(30.0,76.0,14.0,"Derived from mock ARM inventory; no cloud mutation","#a9bdcd");
scene.arrow(450.0,190.0,130.0,280.0,"#6fb6dc",2.0);
scene.arrow(450.0,190.0,340.0,280.0,"#6fb6dc",2.0);
scene.arrow(450.0,190.0,550.0,280.0,"#6fb6dc",2.0);
scene.arrow(450.0,190.0,760.0,280.0,"#6fb6dc",2.0);
scene.rect(330.0,110.0,240.0,80.0,"#244b63");
scene.text(350.0,155.0,16.0,"Listed resources: ${rows.len()-1}","#f4f7fb");
scene.rect(40.0,280.0,180.0,120.0,"#17324d");
scene.text(56.0,322.0,18.0,"Network: ${network}","#f4f7fb");
scene.text(56.0,362.0,15.0,"ARM provider group","#bcd6e8");
scene.rect(250.0,280.0,180.0,120.0,"#17324d");
scene.text(266.0,322.0,18.0,"Storage: ${storage}","#f4f7fb");
scene.text(266.0,362.0,15.0,"ARM provider group","#bcd6e8");
scene.rect(460.0,280.0,180.0,120.0,"#17324d");
scene.text(476.0,322.0,18.0,"Identity: ${identity}","#f4f7fb");
scene.text(476.0,362.0,15.0,"ARM provider group","#bcd6e8");
scene.rect(670.0,280.0,180.0,120.0,"#17324d");
scene.text(686.0,322.0,18.0,"Other: ${other}","#f4f7fb");
scene.text(686.0,362.0,15.0,"Remaining providers","#bcd6e8");
scene.text(30.0,480.0,14.0,"Edges show inventory grouping only; no network or application dependency is inferred.","#a9bdcd");
scene.render_png("images/provider_resource_graph.png",900,560,1);
end _dsl_
savedsl(p,"build/provider_resource_graph_draw.dslb");
r = system ${dsl_cli(p)} --lmcode build/provider_resource_graph_draw.dslb;
assert(r.code == 0);
println("wrote images/provider_resource_graph.png");
println("estimated cost: $0.00");
