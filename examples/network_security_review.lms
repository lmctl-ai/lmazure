# Mock-only Azure metadata analysis; no cloud writes or credentials.
mkdir("images"); mkdir("data"); mkdir("build");
azure = _dsl_ cli="lmazure" install="github:lmctl-ai/lmazure@latest";
let s = mock();
let t = s.inventory("network");
t.csv("data/network_security_review_inventory.csv");
s.readonly_cost_report("data/network_security_review_cost_evidence.json");
end _dsl_
savedsl(azure, "build/network_security_review.dslb");
r = system ${dsl_cli(azure)} --dsl build/network_security_review.dslb;
assert(r.code == 0);
let rows = csv_parse(read_file("data/network_security_review_inventory.csv"), false);
assert(rows.len() == 6);
let ledger = json_parse(read_file("data/network_security_review_cost_evidence.json"));
assert(getstr(ledger, "mode") == "fake");
assert(getnum(ledger, "estimated_cost_usd") == 0);
assert(getnum(ledger, "metadata_inventory.list_requests") == 1);
assert(getlist(ledger, "owned").len() == 0);
let nsg=0;let routes=0;let ips=0;let vnets=0;let dns=0;
for(i in range(1,rows.len())) {
 if(rows[i][1]=="Microsoft.Network/networkSecurityGroups") {nsg=nsg+1;}
 else if(rows[i][1]=="Microsoft.Network/routeTables") {routes=routes+1;}
 else if(rows[i][1]=="Microsoft.Network/publicIPAddresses") {ips=ips+1;}
 else if(rows[i][1]=="Microsoft.Network/virtualNetworks") {vnets=vnets+1;}
 else if(rows[i][1]=="Microsoft.Network/dnsZones") {dns=dns+1;}
}
assert(nsg==1 && routes==1 && ips==1 && vnets==1 && dns==1);
let labels = ["NSG metadata", "Route table", "Public IP", "Virtual network", "DNS zone"];
let values = [nsg,routes,ips,vnets,dns];
let data = "category,count\n";
for (j in range(0, labels.len())) { data = data + labels[j] + "," + str(values[j]) + "\n"; }
write_file("data/network_security_review_derived.csv", data);
p = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/network_security_review.png", 900, 560);
plot.cmd("set title 'MOCK network review inventory (not rule evaluation)'; set xlabel ''; set ylabel 'Resources'; set key off; set yrange [0:*]; set datafile separator ','; set style data histograms; set style fill solid 0.85; set boxwidth 0.65; set xtics norotate; set bmargin 5; plot 'data/network_security_review_derived.csv' every ::1 using 2:xtic(1) lc rgb '#0ea5e9'");
plot.close();
end _dsl_
savedsl(p, "build/network_security_review_plot.dslb");
r = system ${dsl_cli(p)} --dsl build/network_security_review_plot.dslb;
assert(r.code == 0);
println("wrote images/network_security_review.png");
println("estimated cost: $0.00");
