# Mock-only owned lifecycle: Ownership evidence; no Azure calls.
mkdir("images"); mkdir("data"); mkdir("build");
let azure = _dsl_ cli="lmazure" install="github:lmctl-ai/lmazure@latest";
let s = mock();
let run = s.begin_run("build/owned_ownership_evidence.ledger.json");
run.cost_cap(0.05);
let created = run.queue("ownership-evidence");
let resource_name = created.text(0, 0);
run.tag(resource_name, "gallery", "ownership-evidence");
created.csv("data/owned_ownership_evidence_created.csv");

run.cleanup();
run.cost_report("data/owned_ownership_evidence_cost_evidence.json");
end _dsl_
savedsl(azure, "build/owned_ownership_evidence.dslb");
r0 = system ${dsl_cli(azure)} --lmcode build/owned_ownership_evidence.dslb;
assert(r0.code == 0);
let cost_report = json_parse(read_file("data/owned_ownership_evidence_cost_evidence.json"));
assert(getstr(cost_report, "mode") == "fake");
let cost_text = getstr(cost_report, "estimated_cost_text");
assert(getnum(cost_report, "estimated_cost_usd") == 0.0005);
assert(getnum(cost_report, "reserved_cost_usd") == 0.0);
assert(getlist(cost_report, "requests").len() == 5);
let resources = getlist(cost_report, "resources");
let requests = getlist(cost_report, "requests");
let remaining = 0;
for (i in range(0,resources.len())) { if(getbool(resources[i],"owned")) { remaining=remaining+1; } }
assert(remaining==0);
let request_count = requests.len();
let puts=0; let gets=0; let deletes=0;
for(i in range(0,requests.len())) { let method=getstr(requests[i],"method"); if(method=="PUT") {puts=puts+1;} else if(method=="GET" || method=="HEAD") {gets=gets+1;} else if(method=="DELETE") {deletes=deletes+1;} }
assert(puts+gets+deletes==request_count);
let money = split(cost_text,"$")[1];
let reserve = getnum(cost_report,"reserved_cost_usd");
let outcome = "Cleanup complete";
if(r0.code==3) { outcome="Create rejected before HTTP"; }
let outcome_text = outcome + "; values are read from this run ledger";
assert(starts_with(getstr(resources[0],"resource"),"lmazure-"+getstr(cost_report,"run_id")+"-"));
p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(900,560,"#0f1720");
scene.text(30.0,44.0,27.0,"Owned Ownership Evidence","#f4f7fb");
scene.text(30.0,76.0,15.0,${outcome_text},"#a9bdcd");
scene.rect(40.0,155.0,250.0,180.0,"#17324d");
scene.text(60.0,202.0,21.0,"Resources: ${resources.len()}","#f4f7fb");
scene.text(60.0,245.0,16.0,"Owned after run: ${remaining}","#bcd6e8");
scene.text(60.0,288.0,15.0,"Ledger and prefix checks","#bcd6e8");
scene.rect(325.0,155.0,250.0,180.0,"#244b63");
scene.text(345.0,202.0,21.0,"Requests: ${request_count}","#f4f7fb");
scene.text(345.0,245.0,16.0,"PUT ${puts} / GET ${gets}","#bcd6e8");
scene.text(345.0,288.0,16.0,"DELETE ${deletes}","#bcd6e8");
scene.rect(610.0,155.0,250.0,180.0,"#17324d");
scene.text(630.0,202.0,21.0,"Estimate (USD)","#f4f7fb");
scene.text(630.0,245.0,25.0,${money},"#7dd3fc");
scene.text(630.0,288.0,15.0,"Reserved after: ${reserve}","#bcd6e8");
scene.text(30.0,423.0,14.0,"The generated resource prefix matches the ledger run ID; metadata is checked before mutation.","#a9bdcd");
scene.text(30.0,477.0,14.0,"Fake transports only; price-table estimates have not been measured live.","#a9bdcd");
scene.render_png("images/owned_ownership_evidence.png",900,560,1);
end _dsl_
savedsl(p,"build/owned_ownership_evidence_visual.dslb");
r = system ${dsl_cli(p)} --lmcode build/owned_ownership_evidence_visual.dslb;
assert(r.code==0);
println("wrote images/owned_ownership_evidence.png");
println(getstr(cost_report, "estimated_cost_text"));
