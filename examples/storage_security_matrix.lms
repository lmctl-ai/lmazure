# Mock-only Azure metadata analysis; no cloud writes or credentials.
mkdir("images"); mkdir("data"); mkdir("build");
azure = _dsl_ cli="lmazure" install="github:lmctl-ai/lmazure@latest";
let s = mock();
let t = s.inventory("storage");
t.csv("data/storage_security_matrix_inventory.csv");
s.readonly_cost_report("data/storage_security_matrix_cost_evidence.json");
end _dsl_
savedsl(azure, "build/storage_security_matrix.dslb");
r = system ${dsl_cli(azure)} --dsl build/storage_security_matrix.dslb;
assert(r.code == 0);
let rows = csv_parse(read_file("data/storage_security_matrix_inventory.csv"), false);
assert(rows.len() == 4);
let ledger = json_parse(read_file("data/storage_security_matrix_cost_evidence.json"));
assert(getstr(ledger, "mode") == "fake");
assert(getnum(ledger, "estimated_cost_usd") == 0);
assert(getnum(ledger, "metadata_inventory.list_requests") == 1);
assert(getlist(ledger, "owned").len() == 0);
let data="flag,resource,state\n";
for(i in range(1,rows.len())) { for(j in range(0,3)) { let value=rows[i][j+6]; let flag=-1; if(value==true) {flag=1;} else if(value==false) {flag=0;} data=data+str(j)+","+str(i-1)+","+str(flag)+"\n"; } }
write_file("data/storage_security_matrix_derived.csv",data);
assert(rows.len()==4);
p = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/storage_security_matrix.png", 900, 560);
plot.cmd("set title 'MOCK storage flag evidence'; set key off; set datafile separator ','; set xtics ('Public flag' 0,'Encrypted flag' 1,'Owned tag' 2); set ytics ('Storage account 2' 0,'Queue service 6' 1,'Storage account 12' 2); set xrange [-0.5:2.5]; set yrange [-0.5:2.5]; set lmargin 23; set palette defined (-1 '#cbd5e1',0 '#93c5fd',1 '#38bdf8'); set cbrange [-1:1]; set cbtics ('unknown' -1,'false' 0,'true' 1); plot 'data/storage_security_matrix_derived.csv' every ::1 using 1:2:3 with image, '' every ::1 using 1:2:(sprintf('%g',$3)) with labels tc rgb '#0f172a' notitle");
plot.close();
end _dsl_
savedsl(p, "build/storage_security_matrix_plot.dslb");
r = system ${dsl_cli(p)} --dsl build/storage_security_matrix_plot.dslb;
assert(r.code == 0);
println("wrote images/storage_security_matrix.png");
println("estimated cost: $0.00");
