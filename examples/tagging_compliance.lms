# Mock-only Azure tagging compliance review.
mkdir("images"); mkdir("data"); mkdir("build");
azure = _dsl_ cli="lmazure" install="github:lmctl-ai/lmazure@latest";
let s = mock();
let t = s.inventory("resources");
t.csv("data/tagging_compliance.csv");
s.readonly_cost_report("data/tagging_compliance_cost_evidence.json");
end _dsl_
savedsl(azure, "build/tagging_compliance.dslb");
r = system ${dsl_cli(azure)} --dsl build/tagging_compliance.dslb;
assert(r.code == 0);
let rows = csv_parse(read_file("data/tagging_compliance.csv"), false);
assert(rows[0].len() == 10);
let cost_report = json_parse(read_file("data/tagging_compliance_cost_evidence.json"));
assert(getstr(cost_report, "mode") == "fake");
assert(getnum(cost_report, "estimated_cost_usd") == 0.0);
assert(getlist(cost_report, "resources").len() == 0);
let metadata = get(cost_report, "metadata_inventory");
assert(getnum(metadata, "arm_requests") == 1);
assert(rows.len() == 25);
let tagged = 0;
let untagged = 0;
for (i in range(1, rows.len())) {
  if (rows[i][8] == true) { tagged = tagged + 1; }
  else { untagged = untagged + 1; }
}
write_file("data/tagging_compliance_derived.csv", "tag coverage,count\ntagged," + str(tagged) + "\nuntagged," + str(untagged) + "\n");
assert(tagged + untagged == 24);
assert(tagged == 16);
assert(untagged == 8);
p = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/tagging_compliance.png", 900, 560);
plot.cmd("set title 'MOCK tagging compliance review'; set xlabel 'Tag coverage'; set ylabel 'Resources'; set key outside top center horizontal; set yrange [0:*]; set style data histograms; set style fill solid 0.8; set datafile separator ','; plot 'data/tagging_compliance_derived.csv' every ::1 using 2:xtic(1) title 'mock resources'");
plot.close();
end _dsl_
savedsl(p, "build/tagging_compliance_plot.dslb");
r = system ${dsl_cli(p)} --dsl build/tagging_compliance_plot.dslb;
assert(r.code == 0);
println("wrote images/tagging_compliance.png");
println("estimated cost: $0.00");
