# Mock-only Azure metadata analysis; no cloud writes or credentials.
mkdir("images"); mkdir("data"); mkdir("build");
azure = _dsl_ cli="lmazure" install="github:lmctl-ai/lmazure@latest";
let s = mock();
let t = s.inventory("resources");
t.csv("data/stale_ownership_triage_inventory.csv");
s.readonly_cost_report("data/stale_ownership_triage_cost_evidence.json");
end _dsl_
savedsl(azure, "build/stale_ownership_triage.dslb");
r = system ${dsl_cli(azure)} --dsl build/stale_ownership_triage.dslb;
assert(r.code == 0);
let rows = csv_parse(read_file("data/stale_ownership_triage_inventory.csv"), false);
assert(rows.len() == 25);
let ledger = json_parse(read_file("data/stale_ownership_triage_cost_evidence.json"));
assert(getstr(ledger, "mode") == "fake");
assert(getnum(ledger, "estimated_cost_usd") == 0);
assert(getnum(ledger, "metadata_inventory.list_requests") == 1);
assert(getlist(ledger, "owned").len() == 0);
let fresh_tagged = 0; let fresh_untagged = 0; let stale_tagged = 0; let stale_untagged = 0;
for (i in range(1, rows.len())) {
 if (rows[i][5] > 720) { if (rows[i][8] == true) { stale_tagged = stale_tagged + 1; } else { stale_untagged = stale_untagged + 1; } }
 else { if (rows[i][8] == true) { fresh_tagged = fresh_tagged + 1; } else { fresh_untagged = fresh_untagged + 1; } }
}
assert(fresh_tagged == 12 && fresh_untagged == 6 && stale_tagged == 4 && stale_untagged == 2);
write_file("data/stale_ownership_triage_derived.csv", "age,tagged,untagged\nfresh," + str(fresh_tagged) + "," + str(fresh_untagged) + "\nstale," + str(stale_tagged) + "," + str(stale_untagged) + "\n");
p = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/stale_ownership_triage.png", 900, 560);
plot.cmd("set title 'MOCK age and ownership triage'; set ylabel 'Resources'; set key outside top center horizontal; set yrange [0:*]; set datafile separator ','; set style data histograms; set style fill solid 0.85; plot 'data/stale_ownership_triage_derived.csv' every ::1 using 2:xtic(1) title 'tagged', '' every ::1 using 3 title 'untagged'");
plot.close();
end _dsl_
savedsl(p, "build/stale_ownership_triage_plot.dslb");
r = system ${dsl_cli(p)} --dsl build/stale_ownership_triage_plot.dslb;
assert(r.code == 0);
println("wrote images/stale_ownership_triage.png");
println("estimated cost: $0.00");
