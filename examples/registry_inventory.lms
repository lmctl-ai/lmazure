mkdir("images");
mkdir("data");
mkdir("build");
azure = _dsl_ cli="lmazure" install="github:lmctl-ai/lmazure@latest";
let s = mock();
let t = s.inventory("registries");
t.csv("data/registry_inventory.csv");
s.readonly_cost_report("data/registry_inventory_cost_evidence.json");
end _dsl_
savedsl(azure, "build/registry_inventory.dslb");
r = system ${dsl_cli(azure)} --lmcode build/registry_inventory.dslb;
assert(r.code == 0);
let rows = csv_parse(read_file("data/registry_inventory.csv"), false);
assert(rows[0].len() == 10);
assert(rows.len() == 2);
let evidence = json_parse(read_file("data/registry_inventory_cost_evidence.json"));
assert(getstr(evidence, "mode") == "fake");
assert(getnum(evidence, "estimated_cost_usd") == 0.0);
assert(getlist(evidence, "owned").len() == 0);
assert(getnum(evidence, "metadata_inventory.arm_requests") == 1);
let label = rows[1][0];
let kind_name = rows[1][1];
let region = rows[1][2];
let status = rows[1][3];
let age = rows[1][5];
let public_flag = rows[1][6];
let encrypted = rows[1][7];
let tagged = rows[1][8];
let public_text = "unknown"; if (public_flag == true) { public_text = "true"; } if (public_flag == false) { public_text = "false"; }
let encrypted_text = "unknown"; if (encrypted == true) { encrypted_text = "true"; } if (encrypted == false) { encrypted_text = "false"; }
let tagged_text = "unknown"; if (tagged == true) { tagged_text = "true"; } if (tagged == false) { tagged_text = "false"; }
p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(900, 560, "#0f1720");
scene.text(40.0, 52.0, 28.0, "Container Registries inventory", "#f4f7fb");
scene.text(40.0, 82.0, 15.0, "MOCK ARM metadata; no live subscription access", "#9fb3c8");
scene.rect(42.0, 126.0, 816.0, 286.0, "#17324d");
scene.text(72.0, 174.0, 20.0, ${label}, "#f4f7fb");
scene.text(72.0, 216.0, 16.0, ${kind_name}, "#d9e2ec");
scene.text(72.0, 250.0, 16.0, "Region: " + ${region}, "#d9e2ec");
scene.text(72.0, 284.0, 16.0, "Status: " + ${status}, "#d9e2ec");
scene.text(72.0, 318.0, 16.0, "Age hours: " + str(${age}), "#d9e2ec");
scene.text(470.0, 216.0, 16.0, "Public: " + ${public_text}, "#f2c94c");
scene.text(470.0, 250.0, 16.0, "Encrypted: " + ${encrypted_text}, "#f2c94c");
scene.text(470.0, 284.0, 16.0, "Tagged: " + ${tagged_text}, "#f2c94c");
scene.text(470.0, 350.0, 14.0, "Computed from data/registry_inventory.csv", "#9fb3c8");
scene.text(40.0, 492.0, 15.0, "Synthetic flags only; live ARM metadata does not establish security policy.", "#9fb3c8");
scene.render_png("images/registry_inventory.png", 900, 560, 1);
end _dsl_
savedsl(p, "build/registry_inventory_plot.dslb");
r = system ${dsl_cli(p)} --lmcode build/registry_inventory_plot.dslb;
assert(r.code == 0);
println("wrote images/registry_inventory.png");
println("estimated cost: $0.00");
