# Mock-only Azure metadata analysis; no cloud writes or credentials.
mkdir("images"); mkdir("data"); mkdir("build");
azure = _dsl_ cli="lmazure" install="github:lmctl-ai/lmazure@latest";
let s = mock();
let t = s.inventory("resources");
t.csv("data/container_registry_map_inventory.csv");
s.readonly_cost_report("data/container_registry_map_cost_evidence.json");
end _dsl_
savedsl(azure, "build/container_registry_map.dslb");
r = system ${dsl_cli(azure)} --dsl build/container_registry_map.dslb;
assert(r.code == 0);
let rows = csv_parse(read_file("data/container_registry_map_inventory.csv"), false);
assert(rows.len() == 25);
let ledger = json_parse(read_file("data/container_registry_map_cost_evidence.json"));
assert(getstr(ledger, "mode") == "fake");
assert(getnum(ledger, "estimated_cost_usd") == 0);
assert(getnum(ledger, "metadata_inventory.list_requests") == 1);
assert(getlist(ledger, "owned").len() == 0);
let clusters=0;let registries=0;
for(i in range(1,rows.len())) {if(rows[i][1]=="Microsoft.ContainerService/managedClusters") {clusters=clusters+1;} else if(rows[i][1]=="Microsoft.ContainerRegistry/registries") {registries=registries+1;}}
assert(clusters==1 && registries==1);
write_file("data/container_registry_map_derived.csv","metadata,count\nclusters,"+str(clusters)+"\nregistries,"+str(registries)+"\n");
p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(900,560,"#0f1720");
scene.text(30.0,45.0,27.0,"Container service metadata map","#f4f7fb");
scene.text(30.0,76.0,14.0,"Derived from mock ARM inventory; no cloud mutation","#a9bdcd");
scene.arrow(450.0,190.0,225.0,280.0,"#6fb6dc",2.0);
scene.arrow(450.0,190.0,675.0,280.0,"#6fb6dc",2.0);
scene.rect(330.0,110.0,240.0,80.0,"#244b63");
scene.text(350.0,155.0,16.0,"Observed service records: ${clusters+registries}","#f4f7fb");
scene.rect(100.0,280.0,250.0,120.0,"#17324d");
scene.text(116.0,322.0,18.0,"AKS clusters: ${clusters}","#f4f7fb");
scene.text(116.0,362.0,15.0,"Metadata only; no nodes","#bcd6e8");
scene.rect(550.0,280.0,250.0,120.0,"#17324d");
scene.text(566.0,322.0,18.0,"ACR registries: ${registries}","#f4f7fb");
scene.text(566.0,362.0,15.0,"No credential/key access","#bcd6e8");
scene.text(30.0,480.0,14.0,"Grouping does not establish which registry a cluster uses; no deployment or login is attempted.","#a9bdcd");
scene.render_png("images/container_registry_map.png",900,560,1);
end _dsl_
savedsl(p,"build/container_registry_map_draw.dslb");
r = system ${dsl_cli(p)} --dsl build/container_registry_map_draw.dslb;
assert(r.code == 0);
println("wrote images/container_registry_map.png");
println("estimated cost: $0.00");
