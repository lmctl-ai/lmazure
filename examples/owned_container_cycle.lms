# Mock-only owned container lifecycle; no Azure write is possible in this example.
mkdir("images"); mkdir("data"); mkdir("build");
azure = _dsl_ cli="lmazure" install="github:lmctl-ai/lmazure@latest";
let s = mock();
let run = s.begin_run("build/owned_container_cycle.ledger.json");
let created = run.container("gallery");
let resource_name = created.text(0, 0);
run.tag(resource_name, "gallery", "true");
created.csv("data/owned_container_cycle_created.csv");
run.cleanup();
let remaining = s.sweep("build/owned_container_cycle.ledger.json", 0.0);
remaining.csv("data/owned_container_cycle_remaining.csv");
end _dsl_
savedsl(azure, "build/owned_container_cycle.dslb");
r = system ${dsl_cli(azure)} --dsl build/owned_container_cycle.dslb;
assert(r.code == 0);
let created_rows = csv_parse(read_file("data/owned_container_cycle_created.csv"), false);
let remaining_rows = csv_parse(read_file("data/owned_container_cycle_remaining.csv"), false);
assert(created_rows[0].len() == 10);
assert(created_rows.len() == 2);
assert(remaining_rows[0].len() == 10);
assert(remaining_rows.len() == 1);
p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(900, 560, "#0f1720");
scene.text(36.0, 48.0, 28.0, "Owned container lifecycle", "#f4f7fb");
scene.text(36.0, 78.0, 15.0, "Mock ownership ledger; explicit cleanup; no Azure call", "#9fb3c8");
scene.rect(70.0, 160.0, 220.0, 120.0, "#17324d");
scene.text(95.0, 215.0, 20.0, "created", "#f4f7fb");
scene.text(95.0, 248.0, 15.0, "rows: ${created_rows.len() - 1}", "#d9e2ec");
scene.rect(340.0, 160.0, 220.0, 120.0, "#17324d");
scene.text(365.0, 215.0, 20.0, "owned + tagged", "#f4f7fb");
scene.text(365.0, 248.0, 15.0, "ledger verified", "#d9e2ec");
scene.rect(610.0, 160.0, 220.0, 120.0, "#17324d");
scene.text(635.0, 215.0, 20.0, "remaining", "#f4f7fb");
scene.text(635.0, 248.0, 15.0, "rows: ${remaining_rows.len() - 1}", "#d9e2ec");
scene.arrow(290.0, 220.0, 340.0, 220.0, "#f2c94c", 3.0);
scene.arrow(560.0, 220.0, 610.0, 220.0, "#f2c94c", 3.0);
scene.text(70.0, 420.0, 16.0, "The post-cleanup sweep is empty and the ledger is gone.", "#9fb3c8");
scene.render_png("images/owned_container_cycle.png", 900, 560, 1);
end _dsl_
savedsl(p, "build/owned_container_cycle_draw.dslb");
r = system ${dsl_cli(p)} --dsl build/owned_container_cycle_draw.dslb;
assert(r.code == 0);
println("wrote images/owned_container_cycle.png");
