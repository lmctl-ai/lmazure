# Mock-only Azure metadata analysis; no cloud writes or credentials.
mkdir("images"); mkdir("data"); mkdir("build");
azure = _dsl_ cli="lmazure" install="github:lmctl-ai/lmazure@latest";
let s = mock();
let t = s.inventory("resources");
t.csv("data/database_portfolio_inventory.csv");
s.readonly_cost_report("data/database_portfolio_cost_evidence.json");
end _dsl_
savedsl(azure, "build/database_portfolio.dslb");
r = system ${dsl_cli(azure)} --dsl build/database_portfolio.dslb;
assert(r.code == 0);
let rows = csv_parse(read_file("data/database_portfolio_inventory.csv"), false);
assert(rows.len() == 25);
let ledger = json_parse(read_file("data/database_portfolio_cost_evidence.json"));
assert(getstr(ledger, "mode") == "fake");
assert(getnum(ledger, "estimated_cost_usd") == 0);
assert(getnum(ledger, "metadata_inventory.list_requests") == 1);
assert(getlist(ledger, "owned").len() == 0);
let ages=[0,0,0];let found=0;
for(i in range(1,rows.len())) { if(rows[i][1]=="Microsoft.Sql/servers") {ages[0]=rows[i][5];found=found+1;} else if(rows[i][1]=="Microsoft.DBforPostgreSQL/flexibleServers") {ages[1]=rows[i][5];found=found+1;} else if(rows[i][1]=="Microsoft.DocumentDB/databaseAccounts") {ages[2]=rows[i][5];found=found+1;} }
assert(found==3 && ages[0]==6 && ages[1]==6 && ages[2]==960);
let labels = ["SQL server", "PostgreSQL", "Cosmos account"];
let values = ages;
let data = "category,count\n";
for (j in range(0, labels.len())) { data = data + labels[j] + "," + str(values[j]) + "\n"; }
write_file("data/database_portfolio_derived.csv", data);
p = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/database_portfolio.png", 900, 560);
plot.cmd("set title 'MOCK database metadata age (no connections)'; set xlabel ''; set ylabel 'Age hours'; set key off; set yrange [0:*]; set datafile separator ','; set style data histograms; set style fill solid 0.85; set boxwidth 0.65; set xtics norotate; set bmargin 5; plot 'data/database_portfolio_derived.csv' every ::1 using 2:xtic(1) lc rgb '#0ea5e9'");
plot.close();
end _dsl_
savedsl(p, "build/database_portfolio_plot.dslb");
r = system ${dsl_cli(p)} --dsl build/database_portfolio_plot.dslb;
assert(r.code == 0);
println("wrote images/database_portfolio.png");
println("estimated cost: $0.00");
