# Mock-only Azure resource age distribution.
mkdir("images"); mkdir("data"); mkdir("build");
azure = _dsl_ cli="lmazure" install="github:lmctl-ai/lmazure@latest";
let s = mock();
let t = s.inventory("resources");
t.csv("data/age_distribution.csv");
end _dsl_
savedsl(azure, "build/age_distribution.dslb");
r = system ${dsl_cli(azure)} --dsl build/age_distribution.dslb;
assert(r.code == 0);
let rows = csv_parse(read_file("data/age_distribution.csv"), false);
assert(rows[0].len() == 10);
assert(rows.len() == 13);
let fresh = 0;
let recent = 0;
let aging = 0;
let stale = 0;
for (i in range(1, rows.len())) {
  let hours = num(rows[i][5]);
  if (hours < 24.0) { fresh = fresh + 1; }
  else if (hours < 168.0) { recent = recent + 1; }
  else if (hours < 720.0) { aging = aging + 1; }
  else { stale = stale + 1; }
}
write_file("data/age_distribution_derived.csv", "age bucket,count\n< 1 day," + str(fresh) + "\n1-7 days," + str(recent) + "\n8-30 days," + str(aging) + "\n> 30 days," + str(stale) + "\n");
assert(fresh + recent + aging + stale == 12);
p = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/age_distribution.png", 900, 560);
plot.cmd("set title 'MOCK resource age distribution'; set xlabel 'Age bucket'; set ylabel 'Resources'; set yrange [0:*]; set style data histograms; set style fill solid 0.8; set datafile separator ','; plot 'data/age_distribution_derived.csv' every ::1 using 2:xtic(1) title 'mock resources'");
plot.close();
end _dsl_
savedsl(p, "build/age_distribution_plot.dslb");
r = system ${dsl_cli(p)} --dsl build/age_distribution_plot.dslb;
assert(r.code == 0);
println("wrote images/age_distribution.png");
