# Mock-only Azure network topology plan.
mkdir("images"); mkdir("data"); mkdir("build");
azure = _dsl_ cli="lmazure" install="github:lmctl-ai/lmazure@latest";
let s = mock();
let t = s.inventory("network");
t.csv("data/network_topology.csv");
end _dsl_
savedsl(azure, "build/network_topology.dslb");
r = system ${dsl_cli(azure)} --dsl build/network_topology.dslb;
assert(r.code == 0);
let rows = csv_parse(read_file("data/network_topology.csv"), false);
assert(rows[0].len() == 10);
assert(rows.len() == 3);
let resource_count = rows.len() - 1;
p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(900, 560, "#0f1720");
scene.text(36.0, 48.0, 28.0, "Network topology plan", "#f4f7fb");
scene.text(36.0, 78.0, 15.0, "Generated from a redacted mock inventory; no Azure call", "#9fb3c8");
scene.rect(70.0, 160.0, 220.0, 120.0, "#17324d");
scene.text(95.0, 215.0, 20.0, "VNet", "#f4f7fb");
scene.text(95.0, 248.0, 15.0, "inventory rows: ${resource_count}", "#d9e2ec");
scene.rect(340.0, 160.0, 220.0, 120.0, "#17324d");
scene.text(365.0, 215.0, 20.0, "subnets + NSGs", "#f4f7fb");
scene.text(365.0, 248.0, 15.0, "route review", "#d9e2ec");
scene.rect(610.0, 160.0, 220.0, 120.0, "#17324d");
scene.text(635.0, 215.0, 20.0, "egress", "#f4f7fb");
scene.text(635.0, 248.0, 15.0, "deny by default", "#d9e2ec");
scene.arrow(290.0, 220.0, 340.0, 220.0, "#f2c94c", 3.0);
scene.arrow(560.0, 220.0, 610.0, 220.0, "#f2c94c", 3.0);
scene.text(70.0, 420.0, 16.0, "Mock network rows drive a read-only topology review.", "#9fb3c8");
scene.render_png("images/network_topology.png", 900, 560, 1);
end _dsl_
savedsl(p, "build/network_topology_draw.dslb");
r = system ${dsl_cli(p)} --dsl build/network_topology_draw.dslb;
assert(r.code == 0);
println("wrote images/network_topology.png");
