# Mock-only Azure metadata analysis; no cloud writes or credentials.
mkdir("images"); mkdir("data"); mkdir("build");
azure = _dsl_ cli="lmazure" install="github:lmctl-ai/lmazure@latest";
let s = mock();
let t = s.inventory("resources");
t.csv("data/regional_tag_coverage_inventory.csv");
s.readonly_cost_report("data/regional_tag_coverage_cost_evidence.json");
end _dsl_
savedsl(azure, "build/regional_tag_coverage.dslb");
r = system ${dsl_cli(azure)} --lmcode build/regional_tag_coverage.dslb;
assert(r.code == 0);
let rows = csv_parse(read_file("data/regional_tag_coverage_inventory.csv"), false);
assert(rows.len() == 25);
let ledger = json_parse(read_file("data/regional_tag_coverage_cost_evidence.json"));
assert(getstr(ledger, "mode") == "fake");
assert(getnum(ledger, "estimated_cost_usd") == 0);
assert(getnum(ledger, "metadata_inventory.list_requests") == 1);
assert(getlist(ledger, "owned").len() == 0);
let matrix = [[0, 0], [0, 0], [0, 0]];
for (i in range(1, rows.len())) {
let region = 0;
if (rows[i][2] == "westus2") { region = 1; } else if (rows[i][2] == "westeurope") { region = 2; }
let state = 0;
if (rows[i][8] != true) { state = 1; }
matrix[region][state] = matrix[region][state] + 1;
}
let expected_matrix = [[8, 0], [8, 0], [0, 8]];
for (j in range(0,3)) { for (k in range(0,2)) { assert(matrix[j][k] == expected_matrix[j][k]); } }
let regions = ["eastus","westus2","westeurope"];
let data = "region,tagged,untagged\n";
for (j in range(0, 3)) { data = data + regions[j]; for (k in range(0, 2)) { data = data + "," + str(matrix[j][k]); } data = data + "\n"; }
write_file("data/regional_tag_coverage_derived.csv", data);
p = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/regional_tag_coverage.png", 900, 560);
plot.cmd("set title 'MOCK Regional ownership-tag coverage'; set ylabel 'Resources'; set key outside top center horizontal; set yrange [0:*]; set style data histograms; set style histogram rowstacked; set style fill solid 0.85; set boxwidth 0.7; set datafile separator ','; plot 'data/regional_tag_coverage_derived.csv' every ::1 using 2:xtic(1) title 'tagged', '' every ::1 using 3 title 'untagged'");
plot.close();
end _dsl_
savedsl(p, "build/regional_tag_coverage_plot.dslb");
r = system ${dsl_cli(p)} --lmcode build/regional_tag_coverage_plot.dslb;
assert(r.code == 0);
println("wrote images/regional_tag_coverage.png");
println("estimated cost: $0.00");
