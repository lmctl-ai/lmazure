# Mock-only Azure public exposure audit.
mkdir("images"); mkdir("data"); mkdir("build");
azure = _dsl_ cli="lmazure" install="github:lmctl-ai/lmazure@latest";
let s = mock();
let t = s.inventory("resources");
t.csv("data/public_resource_audit.csv");
end _dsl_
savedsl(azure, "build/public_resource_audit.dslb");
r = system ${dsl_cli(azure)} --dsl build/public_resource_audit.dslb;
assert(r.code == 0);
let rows = csv_parse(read_file("data/public_resource_audit.csv"), false);
assert(rows[0].len() == 10);
assert(rows.len() == 13);
let exposed = 0;
let private_count = 0;
let unknown = 0;
for (i in range(1, rows.len())) {
  let value = rows[i][6];
  if (value == true) { exposed = exposed + 1; }
  else if (value == false) { private_count = private_count + 1; }
  else { unknown = unknown + 1; }
}
write_file("data/public_resource_audit_derived.csv", "public exposure,count\npublic," + str(exposed) + "\nprivate," + str(private_count) + "\nunknown," + str(unknown) + "\n");
assert(exposed + private_count + unknown == 12);
assert(exposed == 4);
assert(private_count == 4);
assert(unknown == 4);
p = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/public_resource_audit.png", 900, 560);
plot.cmd("set title 'MOCK public exposure audit'; set xlabel 'Exposure'; set ylabel 'Resources'; set key outside top center horizontal; set yrange [0:*]; set style data histograms; set style fill solid 0.8; set datafile separator ','; plot 'data/public_resource_audit_derived.csv' every ::1 using 2:xtic(1) title 'mock resources'");
plot.close();
end _dsl_
savedsl(p, "build/public_resource_audit_plot.dslb");
r = system ${dsl_cli(p)} --dsl build/public_resource_audit_plot.dslb;
assert(r.code == 0);
println("wrote images/public_resource_audit.png");
println("estimated cost: $0.00");
