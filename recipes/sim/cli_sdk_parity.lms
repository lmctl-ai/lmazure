# Access: Write to azuresim with both lmazure hosts (released --simulator command and the Go lmcloud build)
# What: Interoperability: a blob uploaded by the Azure SDK command is read back through the shared schema and vice versa, byte for byte; a queue message sent by one side is received by the other; both agree on container and queue listings
# When: Mixing deploy scripts that call the lmazure CLI with lmcode programs, or validating two client stacks against the same emulator
# Emulator: azuresim (Blob and Queue Storage) on http://127.0.0.1:4577
# Run: lmscript recipes/sim/cli_sdk_parity.lms --cloud-host bin/lmazure
# Arguments: --endpoint URL --host PATH --cloud-host PATH --account NAME --key BASE64 --run ID --out DIR
# Cleanup: the container and queue are deleted
import "./lib/common.lms";

o = sim_options("cli_sdk_parity", {}, "usage: cli_sdk_parity.lms [--endpoint URL] [--host PATH] [--cloud-host PATH]");
container = "lmazure-sim-parity-" + o.run;
queue = "lmazure-sim-parity-q-" + o.run;
cli_body = "<!doctype html><h1>uploaded by the Azure SDK command (雪)</h1>\n";
sdk_body = "<!doctype html><h1>uploaded through the shared lmcloud schema</h1>\n";
write_file(o.out + "/from-cli.html", cli_body);

az_cli_env(o);
az_cli_ok(o, ["container-create", container]);
az_cli_ok(o, ["blob-put", container, "from-cli.html", o.out + "/from-cli.html"]);
az_cli_ok(o, ["queue-create", queue]);
az_cli_ok(o, ["queue-send", queue, "sent by the CLI"]);

cross = _lmcode_ schema="../../schema/lmcloud.dsl.json";
  cloud.set_endpoint("all", ${o.endpoint});
  let c = ${container};
  let q = ${queue};
  lmcode_return_put("cli_blob_via_schema", cloud.object_get(c, "from-cli.html"));
  cloud.object_put(c, "from-schema.html", ${sdk_body}, "text/html; charset=utf-8", str_map());
  let got = cloud.queue_receive(q, 1, 2, 30);
  let body = "";
  if (got.len() > 0) { body = got.at(0).body(); cloud.queue_ack(q, got.at(0).receipt()); }
  lmcode_return_put("cli_message_via_schema", body);
  cloud.queue_send(q, "sent through the schema");
  lmcode_return_put("containers_seen", cloud.bucket_list().contains(c));
  lmcode_return_put("queues_seen", cloud.queue_list().contains(q));
  lmcode_return_put("blob_count", cloud.object_list_all(c, "").len());
end _lmcode_
r = sim_run(cross, az_cloud_command(o)).result;

az_cli_ok(o, ["blob-get", container, "from-schema.html", o.out + "/from-schema.html"]);
schema_blob_via_cli = read_file(o.out + "/from-schema.html");
received = az_cli_ok(o, ["queue-receive", queue]);
cli_message = getstr(received, "message");
if (getstr(received, "id") != "") { az_cli_ok(o, ["queue-delete-message", queue, received.id, received.receipt]); }

cleanup = _lmcode_ schema="../../schema/lmcloud.dsl.json";
  cloud.set_endpoint("all", ${o.endpoint});
  for (k in cloud.object_list_all(${container}, "")) { cloud.object_delete(${container}, k); }
  lmcode_return_put("container_deleted", cloud.bucket_delete(${container}));
  lmcode_return_put("queue_deleted", cloud.queue_delete(${queue}));
end _lmcode_
t = sim_run(cleanup, az_cloud_command(o)).result;

assert(r.cli_blob_via_schema == cli_body && schema_blob_via_cli == sdk_body, "blobs must read back identically across the two clients");
assert(r.blob_count == 2 && r.containers_seen && r.queues_seen, "both clients must see the same container, blobs and queue");
assert(r.cli_message_via_schema == "sent by the CLI", "a CLI-sent queue message must be readable through the schema, got " + json_stringify(r.cli_message_via_schema));
queue_parity = cli_message == "sent through the schema";
if (!queue_parity) { println("note: the schema base64-encodes queue payloads on the wire, so the CLI shows the encoded form: " + cli_message); }
assert(t.container_deleted && t.queue_deleted, "cleanup must remove container and queue");
println("blob parity both ways; CLI->schema queue message intact; schema->CLI queue message " + if_else(queue_parity, "intact", "base64 on the wire (documented)") + "; container and queue removed");
sim_report(o, {endpoint: o.endpoint, host: "lmazure --simulator + lmazure cloud", schema_view: r, cli_message_seen: cli_message, queue_parity: queue_parity, cleanup: t});
sim_pass(o);
